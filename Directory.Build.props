<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <Version>2.0.17</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyTitle>VStoVSC</AssemblyTitle>
    <AssemblyDescription>Visual Studio ソリューション (.sln / .slnx) を VS Code 用に変換するツール</AssemblyDescription>
    <Company>Kagayoi</Company>
    <AssemblyProduct>VStoVSC</AssemblyProduct>
    <Copyright>Copyright © 2026 Kagayoi</Copyright>
    <Title>VStoVSC</Title>
    <Authors>Kagayoi</Authors>
    <!-- NuGet 依存のサプライチェーン保護: lockfile (packages.lock.json) を生成・検証する。 -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- IDE コードスタイル分析をビルド時にも強制する。IDE0005 はドキュメント生成が必須なため対象外。 -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
</Project>
